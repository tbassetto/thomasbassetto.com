{
  "installCommand": "npm exec --yes --package=pnpm@12.21.0 -- pnpm install --frozen-lockfile",
  "buildCommand": "npm exec --yes --package=pnpm@12.21.0 -- pnpm build",
  "rewrites": [
    {
      "source": "/js/script.js",
      "destination": "https://plausible.io/js/script.js"
    },
    {
      "source": "/api/event",
      "destination": "https://plausible.io/api/event"
    }
  ]
}
