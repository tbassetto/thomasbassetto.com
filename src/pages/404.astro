---
import { SITE_TITLE } from '../consts';
import DefaultLayout from '../layouts/DefaultLayout.astro';
---

<DefaultLayout title={`Page not found | ${SITE_TITLE}`} description="The requested page could not be found.">
	<main class="not-found wrap">
		<h1>Page not found</h1>
		<p>The page you’re looking for doesn’t exist.</p>
		<a class="button primary" href="/">Return home →</a>
	</main>
</DefaultLayout>

<style>
	.not-found {
		display: grid;
		place-content: center;
		min-height: 100vh;
		text-align: center;
	}

	.not-found h1 {
		margin-bottom: 1rem;
		font-size: clamp(3rem, 10vw, 7rem);
	}

	.not-found p {
		color: var(--muted);
	}

	.not-found .button {
		justify-self: center;
	}
</style>
