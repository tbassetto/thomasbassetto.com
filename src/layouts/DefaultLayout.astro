---
import '@fontsource-variable/spline-sans';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

type Props = {
	title?: string;
	description?: string;
	jsonLd?: Record<string, unknown> | undefined;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} jsonLd={jsonLd} />
		<meta name="theme-color" content="#dceff0" data-theme-color />
		<script is:inline>
			(() => {
				let savedTheme = null;
				try {
					savedTheme = localStorage.getItem('theme');
				} catch {}

				const theme =
					savedTheme === 'light' || savedTheme === 'dark'
						? savedTheme
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';

				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
	</head>
	<body>
		<div class="nature-backdrop" aria-hidden="true">
			<div class="nature-scene nature-day"></div>
			<div class="nature-scene nature-night"></div>
		</div>
		<slot />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const toggle = document.querySelector('[data-theme-toggle]');
				const label = toggle?.querySelector('[data-theme-label]');
				const themeColor = document.querySelector('[data-theme-color]');
				const media = window.matchMedia('(prefers-color-scheme: dark)');

				const sync = (theme) => {
					const dark = theme === 'dark';
					root.dataset.theme = theme;
					root.style.colorScheme = theme;
					toggle?.setAttribute('aria-pressed', String(dark));
					toggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
					if (label) label.textContent = dark ? 'Day' : 'Night';
					if (themeColor) themeColor.setAttribute('content', dark ? '#071927' : '#dceff0');
				};

				sync(root.dataset.theme === 'dark' ? 'dark' : 'light');

				toggle?.addEventListener('click', () => {
					const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
					try {
						localStorage.setItem('theme', nextTheme);
					} catch {}
					sync(nextTheme);
				});

				media.addEventListener('change', (event) => {
					try {
						if (localStorage.getItem('theme')) return;
					} catch {}
					sync(event.matches ? 'dark' : 'light');
				});
			})();
		</script>
	</body>
</html>
